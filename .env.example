# === Backend seguro InfinitePay (Supabase Edge Functions) ===
# Configurados como SECRETS das Edge Functions no painel Supabase
# (Project Settings > Edge Functions > Secrets), NUNCA no frontend.
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sao injetados automaticamente
# pelo Supabase em toda Edge Function — nao precisa setar.

# InfiniteTag da conta (sem o "$"). Publico, mas centralizado aqui.
INFINITEPAY_HANDLE=nathalialouise

# Base da API de checkout da InfinitePay.
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io

# Origem publica do site (usada em redirect_url e no CORS das functions).
APP_URL=https://gangcorreparty-lp.vercel.app

# OBS: a InfinitePay NAO exige token/API key pra POST /links nem /payment_check
# (confirmado ao vivo em 2026-07-22 — responde 200 so com o handle).
# Se um dia passar a exigir, adicionar aqui INFINITEPAY_API_TOKEN= e ler via
# Deno.env.get no modulo de integracao.
